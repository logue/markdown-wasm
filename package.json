{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@logue/markdown-wasm",
  "type": "module",
  "version": "1.5.0",
  "license": "MIT",
  "description": "Markdown parser and html generator implemented in WebAssembly",
  "homepage": "https://github.com/logue/markdown-wasm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logue/markdown-wasm.git"
  },
  "author": {
    "name": "rsms",
    "url": "https://rsms.me/"
  },
  "contributors": [
    {
      "name": "Logue",
      "email": "logue@hotmail.co.jp",
      "url": "https://logue.dev"
    }
  ],
  "main": "dist/markdown.umd.js",
  "module": "dist/markdown.es.js",
  "types": "markdown.d.ts",
  "exports": {
    ".": {
      "import": "./dist/markdown.es.js",
      "require": "./dist/markdown.umd.js"
    }
  },
  "files": [
    "./src/markdown.wasm",
    "./src/markdown.js",
    "./src/markdown.d.ts",
    "./src/index.js",
    "./dist",
    "markdown.d.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "pnpm": ">=1.15.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "vite",
    "clean": "rimraf node_modules/.vite",
    "build": "run-p build-wasm build-only",
    "build:clean": "rimraf dist",
    "build-wasm": "cd src && build",
    "build-only": "vite build",
    "build-docs": "vite build --mode=docs",
    "lint": "eslint . --fix --cache --cache-location ./node_modules/.vite/vite-plugin-eslint && prettier . --write",
    "test": "vitest --root src",
    "test:spec": "node test/spec/spec.js",
    "test:example": "node example/example.js",
    "prepare": "husky install",
    "version": "auto-changelog -p && git add CHANGELOG.md"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.17.0",
    "@rollup/pluginutils": "^5.1.4",
    "@types/emscripten": "^1.39.13",
    "@types/node": "^22.10.2",
    "commonmark-spec": "^0.31.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^50.6.1",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "vite": "^6.0.4",
    "vite-plugin-banner": "^0.8.0",
    "vite-plugin-checker": "^0.8.0",
    "vite-plugin-static-copy": "^2.2.0",
    "vite-plugin-top-level-await": "^1.4.4",
    "vite-plugin-wasm": "^3.3.0",
    "vitest": "^2.1.8"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts,json,htm,html}": "eslint --fix --cache --cache-location ./node_modules/.vite/vite-plugin-eslint",
    "*": "prettier -w -u"
  },
  "resolutions": {
    "json5": ">=2.2.3",
    "yaml": ">=2.3.2"
  }
}
