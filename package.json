{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@logue/markdown-wasm",
  "type": "module",
  "version": "1.5.5",
  "license": "MIT",
  "description": "Markdown parser and html generator implemented in WebAssembly",
  "homepage": "https://github.com/logue/markdown-wasm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logue/markdown-wasm.git"
  },
  "author": {
    "name": "rsms",
    "url": "https://rsms.me/"
  },
  "contributors": [
    {
      "name": "Logue",
      "email": "logue@hotmail.co.jp",
      "url": "https://logue.dev"
    }
  ],
  "main": "dist/markdown.umd.js",
  "module": "dist/markdown.es.js",
  "jsdelivr": "dist/markdown.iife.js",
  "unpkg": "dist/markdown.iife.js",
  "types": "markdown.d.ts",
  "exports": {
    ".": {
      "import": "./dist/markdown.es.js",
      "types": "./markdown.d.ts",
      "require": "./dist/markdown.cjs.js",
      "default": "./dist/markdown.es.js"
    },
    "./umd": {
      "default": "./dist/markdown.umd.js"
    },
    "./iife": {
      "default": "./dist/markdown.iife.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "./src/markdown.wasm",
    "./src/markdown.js",
    "./src/markdown.d.ts",
    "./src/index.js",
    "./dist",
    "markdown.d.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node" : ">=18",
    "pnpm": ">=10.3.0"
  },
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "vite",
    "clean": "rimraf node_modules/.vite",
    "build": "run-p build-wasm build-only",
    "build:clean": "rimraf dist",
    "build-wasm": "cd src && build",
    "build-only": "vite build",
    "build-docs": "vite build --mode=docs",
    "lint": "eslint . --fix --cache --cache-location ./node_modules/.vite/vite-plugin-eslint && prettier . --write",
    "test": "vitest --root src",
    "test:spec": "node test/spec/spec.js",
    "test:example": "node example/example.js",
    "prepare": "husky",
    "version": "auto-changelog -p && git add CHANGELOG.md"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@rollup/pluginutils": "^5.2.0",
    "@types/emscripten": "^1.40.1",
    "@types/node": "^24.0.13",
    "commonmark-spec": "^0.31.2",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-custom-alias": "^1.3.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^51.3.4",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "vite": "^7.0.4",
    "vite-plugin-banner": "^0.8.1",
    "vite-plugin-checker": "^0.10.0",
    "vite-plugin-static-copy": "^3.1.0",
    "vite-plugin-top-level-await": "^1.5.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^3.2.4"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts,json,htm,html}": "eslint --fix --cache --cache-location ./node_modules/.vite/vite-plugin-eslint",
    "*": "prettier -w -u"
  },
  "resolutions": {
    "json5": ">=2.2.3",
    "yaml": ">=2.3.2"
  }
}
