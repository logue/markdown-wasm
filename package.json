{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@logue/markdown-wasm",
  "private": true,
  "version": "1.7.0",
  "description": "Markdown parser and html generator implemented in WebAssembly",
  "keywords": [],
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Logue",
    "email": "logue@hotmail.co.jp",
    "url": "https://logue.dev/"
  },
  "homepage": "https://github.com/logue/markdown-wasm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logue/markdown-wasm.git"
  },
  "bugs": {
    "url": "https://github.com/logue/rstack-library-starter/issues"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "default": "./dist/index.es.js"
    },
    "./umd": {
      "default": "./dist/index.umd.js",
      "import": "./dist/index.umd.js"
    },
    "./markdown.wasm": {
      "default": "./dist/markdown.wasm",
      "import": "./dist/markdown.wasm"
    },
    "./mf-manifest.json": "./dist/mf-manifest.json",
    "./package.json": "./package.json"
  },
  "packageManager": "pnpm@11.24.0",
  "sideEffects": false,
  "scripts": {
    "dev": "rslib --watch",
    "dev:demo": "rsbuild --open",
    "lint": "run-s 'lint:*' --",
    "lint:rslint": "rslint .",
    "lint:biome": "biome check --write",
    "inspect": "rslib inspect",
    "inspect:demo": "rsbuild inspect",
    "build": "rslib build && mkdir -p dist dist/generated && cp -f src/generated/markdown.wasm dist/markdown.wasm && cp -f src/generated/markdown.wasm dist/generated/markdown.wasm",
    "build:emcc": "cd native && mkdir -p build && cd build && emcmake cmake .. && emmake make",
    "build:demo": "rsbuild build",
    "preview": "rsbuild preview",
    "test": "rstest",
    "test:watch": "rstest --watch",
    "clean": "rimraf demo dist docs",
    "clean:hard": "rimraf demo dist docs node_modules/.tmp node_modules/.cache",
    "version": "auto-changelog -p && git add CHANGELOG.md"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@logue/biome-plugins": "^0.0.3",
    "@microsoft/api-extractor": "^7.59.0",
    "@module-federation/rsbuild-plugin": "^2.9.0",
    "@rsbuild/core": "^2.2.1",
    "@rsbuild/plugin-type-check": "^1.6.0",
    "@rslib/core": "^0.23.2",
    "@rslint/core": "^0.8.2",
    "@rstest/adapter-rslib": "^0.11.10",
    "@rstest/core": "^0.11.10",
    "@tsconfig/node-lts": "^24.0.1",
    "@types/emscripten": "^1.41.5",
    "@types/node": "^26.4.0",
    "commonmark-spec": "^0.31.2",
    "highlight.js": "^11.12.0",
    "npm-run-all2": "^9.0.3",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "preferUnplugged": [
    "markdown-wasm"
  ]
}
